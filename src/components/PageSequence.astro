---
import {readingOrder} from '../data/content.mjs';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const slug=decodeURIComponent(Astro.url.pathname.slice(base.length)).replace(/^\/|\/$/g,'');
const position=readingOrder.findIndex(page=>page.slug===slug);
const previous=readingOrder[position-1],next=readingOrder[position+1];
const link=(p)=>`${base}/${p.slug?p.slug+'/':''}`;
---
{position>=0?<nav class="page-sequence" aria-label="Reading journey" data-page-sequence data-position={position+1} data-total={readingOrder.length}>
 <div class="sequence-links">
  {previous?<a class="sequence-link sequence-previous" href={link(previous)} rel="prev" data-sequence-previous><span>← Previous page</span><strong>{previous.title}</strong></a>:<div class="sequence-end"><span>First page</span><p>The journey begins here.</p></div>}
  <p class="sequence-position">Page <strong>{position+1}</strong> of {readingOrder.length}</p>
  {next?<a class="sequence-link sequence-next" href={link(next)} rel="next" data-sequence-next><span>Next page →</span><strong>{next.title}</strong></a>:<div class="sequence-end sequence-complete"><span>End of the journey</span><p>The documents above are here to explore as you choose.</p></div>}
 </div>
</nav>:slug!=='404'&&<nav class="reference-return" aria-label="Return from reference" data-reference-navigation><a href={`${base}/${slug==='interview'?'start':'library'}/`}>← Return to {slug==='interview'?'the interview introduction':'the document library'}</a><a href={`${base}/site-map/`}>Site index</a></nav>}
