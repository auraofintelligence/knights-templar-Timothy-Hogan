---
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<figure class="original-interview" data-original-interview>
 <div class="interview-player">
  <iframe
   src="https://www.youtube-nocookie.com/embed/K7Dy7MUw-G0?autoplay=0&playsinline=1&rel=0"
   title="Original Timothy Hogan interview that inspired this collection"
   width="960"
   height="540"
   loading="lazy"
   referrerpolicy="strict-origin-when-cross-origin"
   allow="encrypted-media; fullscreen; picture-in-picture; web-share"
   allowfullscreen
  ></iframe>
 </div>
 <figcaption>
  <span>The interview that sparked this conversation</span>
  <div><a href="https://www.youtube.com/watch?v=K7Dy7MUw-G0" target="_blank" rel="noopener">Watch on YouTube ↗</a><a href={`${base}/interview/`}>Read the transcript</a></div>
 </figcaption>
</figure>
<style>
 .original-interview{margin:2.5rem 0 .5rem;width:100%}
 .interview-player{width:100%;aspect-ratio:16/9;min-height:200px;background:var(--ink);overflow:hidden;border-radius:4px}
 iframe{display:block;width:100%;height:100%;min-height:200px;border:0}
 figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.8rem 1.5rem;padding-top:1rem;font-size:.875rem;line-height:1.6;color:#4a6064}
 figcaption>div{display:flex;gap:1.3rem;flex-wrap:wrap}
 @media(max-width:640px){.original-interview{margin-top:2rem}figcaption{display:block}figcaption>div{margin-top:.6rem}}
 @media print{.interview-player{display:none}figcaption{padding:1rem;border:1px solid #aaa}}
</style>
