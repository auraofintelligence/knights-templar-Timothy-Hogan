---
import Site from '../layouts/Site.astro';
import SlideViewer from '../components/SlideViewer.astro';
import Matrix from '../components/Matrix.astro';
import InterviewEmbed from '../components/InterviewEmbed.astro';
import AuraWorldbuildingSlide from '../components/AuraWorldbuildingSlide.astro';
import {allPages,readingOrder,catalogue,redirects,repoURL,repositoryCopy} from '../data/content.mjs';
import licence from '../../LICENCE.md?raw';
import credits from '../../docs/image-provenance.json';
export function getStaticPaths(){return [
 ...allPages.map(page=>({params:{slug:page.slug},props:{page}})),
 ...Object.entries(redirects).map(([slug,target])=>({params:{slug},props:{target}}))
]}
const {page,target}=Astro.props;
const b=import.meta.env.BASE_URL.replace(/\/$/,'');
const l=(p='')=>`${b}/${p?p+'/':''}`;
const families=[...new Set(catalogue.projects.flatMap(p=>p.families))].sort();
const optional=allPages.filter(p=>p.kind!=='source'&&!readingOrder.some(stop=>stop.slug===p.slug));
---
{target ? <html lang="en-AU" data-merged-page><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><meta http-equiv="refresh" content={`0;url=${b}/${target}`}/><link rel="canonical" href={`https://auraofintelligence.github.io${b}/${target}`}/><title>Page moved</title></head><body><p>This topic now lives in the shorter reading journey.</p><a href={`${b}/${target}`}>Continue to the page</a></body></html> :
<Site title={page.title} description={page.description} image={page.image} section={page.section}>
 <section class="hero interior-hero"><picture><source media="(max-width:640px)" srcset={`${b}/media/heroes/${page.image}-mobile.webp`}/><img class="hero-image" src={`${b}/media/heroes/${page.image}.webp`} width="1672" height="941" alt="" fetchpriority="high"/></picture><div class="hero-shade"></div><div class="hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={l()}>Home</a>{page.kind==='source'&&<><span aria-hidden="true">/</span><a href={l('library')}>Library</a></>}</nav><h1>{page.title}</h1><p class="hero-deck">{page.description}</p></div><p class="art-caption">Imagined concept artwork</p></section>
 <div class="reading-tools"><a href={l('site-map')}>Site index</a><button data-share>Copy page link</button><button data-print>Print this page</button></div>
 <div class:list={['article-shell',{'wide-content':['directory','library','gallery','sitemap'].includes(page.kind)}]}>
  {page.sections.length>2&&<aside class="contents"><p>On this page</p><nav aria-label="On this page">{page.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav></aside>}
  <article class="article-body">
   {page.sections.map((section,i)=><section id={section.id} class="essay-section"><h2>{section.title}</h2>{section.paragraphs.map(text=><p>{text}</p>)}{section.links.length>0&&<div class="source-links">{section.links.map(link=><a href={link.href}>{link.label} ↗</a>)}</div>}{page.slug==='start'&&i===0&&<InterviewEmbed/>}{page.kind==='aura'&&section.id==='origins'&&<AuraWorldbuildingSlide/>}{page.kind==='aura'&&section.id==='matrix'&&<Matrix/>}</section>)}
   {page.kind==='transcript'&&<section>
    <p class="source-note">Supplied transcript. Transcription errors and unclear speaker changes remain in the original wording.</p>
    <div class="action-row"><a href="https://www.youtube.com/watch?v=K7Dy7MUw-G0">Watch on YouTube ↗</a><a href={`${b}/downloads/source-61/Transcript.md`} download>Download Transcript.md</a></div>
    <nav class="gallery-index" aria-label="Interview chapters">{catalogue.chapters.map(ch=><a href={`#${ch.id}`}>{ch.number}. {ch.title}</a>)}</nav>
    <div class="filter-bar"><label>Find words in the transcript<input type="search" data-filter-input placeholder="Search all twelve chapters"/></label><p data-filter-count aria-live="polite"></p></div>
    {catalogue.chapters.map(ch=><section id={ch.id} class="essay-section"><h2>{ch.number}. {ch.title}</h2><div class="transcript">{ch.cues.filter(c=>c.text).map((cue,i)=><div class="transcript-cue" id={`${ch.id}-cue-${i}`} data-filter-item data-search={cue.text.toLowerCase()}><a href={`https://www.youtube.com/watch?v=K7Dy7MUw-G0&t=${cue.seconds}s`} target="_blank" rel="noopener" aria-label={`Watch at ${cue.time}`}>{cue.time}</a><p>{cue.text}</p></div>)}</div></section>)}
   </section>}
   {page.kind==='directory'&&<section><div class="filter-bar"><label>Search projects<input type="search" data-filter-input placeholder="Project name or subject"/></label><label>Project family<select data-filter-select><option value="">All families</option>{families.map(f=><option value={f.toLowerCase()}>{f}</option>)}</select></label><p data-filter-count aria-live="polite"></p></div><div class="project-grid">{catalogue.projects.map(project=><section id={project.name} class="project-card" data-filter-item data-search={`${project.title} ${project.name} ${project.description} ${project.families.join(' ')}`.toLowerCase()} data-category={project.families.join('|').toLowerCase()}><p class="small-copy">{project.snapshot?'Source copy included':'Project Atlas entry'}{project.firstBuilt&&` · ${project.firstBuilt}`}</p><h3>{project.title}</h3><p>{project.description}</p><div class="card-links"><a href={project.repositoryUrl} target="_blank" rel="noopener">GitHub ↗</a>{project.publicPage&&<a href={project.publicPage} target="_blank" rel="noopener">Website ↗</a>}{project.snapshot&&<a href={repositoryCopy(project.name)}>Collected copy ↗</a>}</div></section>)}</div></section>}
   {page.kind==='library'&&<section><div class="filter-bar"><label>Search documents<input type="search" data-filter-input placeholder="Document title or format"/></label><label>Format<select data-filter-select><option value="">All formats</option>{[...new Set(catalogue.sources.map(s=>s.format))].sort().map(f=><option value={f.toLowerCase()}>{f}</option>)}</select></label><p data-filter-count aria-live="polite"></p></div><div class="library-list">{catalogue.sources.map(source=><a href={l(`library/${source.id}`)} data-filter-item data-search={`${source.title} ${source.filename} ${source.group} ${source.format}`.toLowerCase()} data-category={source.format.toLowerCase()}><span class="file-type">{source.format}</span><div><h3>{source.title}</h3><p>{(source.bytes/1048576).toFixed(2)} MB{source.previews.length>1&&` · ${source.previews.length} pages or slides`}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>}
   {page.kind==='source'&&<section class="essay-section"><div class="action-row"><a class="button" href={`${b}/${page.source.download}`} download>Download the original</a><a class="button" href={page.source.url}>GitHub copy ↗</a>{page.source.pdf&&<a class="button" href={`${b}/${page.source.pdf}`}>PDF companion</a>}</div>{page.source.previews.length>0&&<SlideViewer source={page.source}/>}<details class="record-details"><summary>File record and checksum</summary><p>{page.source.filename}</p><p>{page.source.bytes.toLocaleString('en-AU')} bytes</p><code>{page.source.sha256}</code></details>{page.source.text&&<details class="source-text"><summary>Read the extracted text</summary><p class="source-note">Extracted for reading; layout and transcription may differ from the original.</p><pre>{page.source.text}</pre></details>}</section>}
   {page.kind==='gallery'&&<section><h2>The six presentations</h2><nav class="gallery-index" aria-label="Presentation index">{catalogue.sources.filter(s=>s.format==='PPTX').map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav>{catalogue.sources.filter(s=>s.format==='PPTX').map(source=><div id={source.id}><SlideViewer source={source}/></div>)}<h2>Original images</h2><div class="image-gallery">{catalogue.sources.filter(s=>['PNG','JPEG','JPG'].includes(s.format)).map(source=><a href={l(`library/${source.id}`)}><img src={`${b}/${source.previews[0]?.src}`} width={source.previews[0]?.width} height={source.previews[0]?.height} alt={source.title} loading="lazy"/><span>{source.title}</span></a>)}</div></section>}
   {page.kind==='licence'&&<pre class="licence-text">{licence}</pre>}
   {page.kind==='sources'&&<><section class="essay-section"><h2>Archive records</h2><div class="source-links"><a href={`${repoURL}/blob/main/REFERENCE_REGISTER.md`}>File and repository register</a><a href={`${repoURL}/blob/main/analysis/ALL_REPOSITORIES.md`}>Local repository directory</a><a href={`${repoURL}/blob/main/THIRD_PARTY_NOTICES.md`}>Third-party notices</a></div></section><section class="essay-section"><h2>Artwork credits</h2><div class="credit-grid">{credits.map(credit=><div><img src={`${b}/media/heroes/${credit.name}.webp`} width="1672" height="941" loading="lazy" alt={`${credit.name} concept artwork`}/><h3>{credit.name}</h3><p>{credit.purpose}. Generated {credit.date}.</p><a href={`${repoURL}/blob/main/${credit.original}`}>Original image ↗</a></div>)}</div><a href={`${repoURL}/blob/main/docs/image-provenance.json`}>Image prompts and provenance</a></section></>}
   {page.kind==='sitemap'&&<>{[['Reading journey',readingOrder],['Optional references',optional],['Documents',allPages.filter(p=>p.kind==='source')]].map(([title,items])=><section class="essay-section"><h2>{title}</h2><div class="site-map-links">{items.map(p=><a href={l(p.slug)}>{p.title}</a>)}</div></section>)}</>}
  </article>
 </div>
</Site>}
