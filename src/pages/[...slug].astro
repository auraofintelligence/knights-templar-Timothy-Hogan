---
import Site from '../layouts/Site.astro';
import SlideViewer from '../components/SlideViewer.astro';
import Matrix from '../components/Matrix.astro';
import InterviewEmbed from '../components/InterviewEmbed.astro';
import {allPages,editorial,catalogue,findPage,repoURL,repositoryCopy} from '../data/content.mjs';
import licence from '../../LICENCE.md?raw';
import credits from '../../docs/image-provenance.json';
export function getStaticPaths(){return allPages.map(page=>({params:{slug:page.slug},props:{page}}))}
const {page}=Astro.props;
const b=import.meta.env.BASE_URL.replace(/\/$/,'');
const l=(p='')=>`${b}/${p?p+'/':''}`;
const sourceLinks=catalogue.sources.filter(s=>(page.sources||[]).some(prefix=>s.group.startsWith(prefix)));
const related=(page.related||[]).map(findPage).filter(Boolean);
const families=[...new Set(catalogue.projects.flatMap(p=>p.families))].sort();
const timelines=[['2013','We Will Be Heard','An early expression of the core philosophy, described in the supplied analysis.','library'],['2014','The constitutional matrix','Personal reflection, participation and the foundation of the wider Aura exploration.','aura'],['2019','Solar Swarm','The independent solar-sensing research thread begins.','horizons/solar-sensing'],['2021','500 Queens','The founder presentations record an ambitious network proposal.','network/queens'],['2022','Luke’s Toolbox','A presentation of creative and technical interests at that time.','gallery'],['2023','Aura and imagined futures','The Aura deck and What Would You Choose scenario open different views of the work.','library'],['2025','Geode and Genesis','A longer exploration of repeated experience and a developing twin relationship.','aura/genesis'],['2026','A growing public ecosystem','The supplied Project Atlas snapshot brings 152 project entries into view.','projects'],['11 September 2026, 11:11 am','The first contact-form message','Luke’s account of sending the invitation through Timothy Hogan’s website.','11-11'],['Five minutes later','The follow-up','After laughing with friends, another message points to the Australian-time synchronicity.','11-11'],['2028-2038','Long horizons','Eclipses and proposed gatherings offer a calendar for further imagination.','horizons/eclipse-decade']];
---
<Site title={page.title} description={page.description} image={page.image} section={page.section}>
 <section class="hero interior-hero"><picture><source media="(max-width:640px)" srcset={`${b}/media/heroes/${page.image}-mobile.webp`}/><img class="hero-image" src={`${b}/media/heroes/${page.image}.webp`} width="1672" height="941" alt="" fetchpriority="high"/></picture><div class="hero-shade"></div><div class="hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={l()}>Home</a><span aria-hidden="true">/</span><a href={l(page.section)}>{page.section==='network'?'Aura and network':page.section}</a></nav><h1>{page.title}</h1><p class="hero-deck">{page.description}</p></div><p class="art-caption">Imagined concept artwork</p></section>
 <div class="reading-tools"><a href={l('site-map')}>All pages</a><button data-share>Copy page link</button><button data-print>Print this page</button></div>
 <div class:list={['article-shell',{'wide-content':['directory','library','gallery','matrix','sitemap'].includes(page.kind)}]}>
  {page.sections.length>2&&<aside class="contents"><p>On this page</p><nav aria-label="On this page">{page.sections.map((s,i)=><a href={`#section-${i}`}>{s.title}</a>)}</nav></aside>}
  <article class="article-body">
   {page.sections.map((section,i)=><section id={`section-${i}`} class="essay-section"><h2>{section.title}</h2>{section.paragraphs.map(text=><p>{text}</p>)}{page.slug==='start'&&i===0&&<InterviewEmbed/>}</section>)}
   {page.kind==='matrix'&&<Matrix/>}
   {['interview','transcript'].includes(page.kind)&&<section class="essay-section"><div class="section-heading"><h2>The conversation</h2><a class="button" href="https://www.youtube.com/watch?v=K7Dy7MUw-G0" target="_blank" rel="noopener">Watch the original ↗</a></div><p>The supplied transcript is divided into its 12 chapters. Timestamps open the original video at that moment. Speaker changes have not been guessed.</p><div class="chapter-list">{catalogue.chapters.map(ch=><a href={l(`interview/${ch.id}`)}><span>{String(ch.number).padStart(2,'0')}</span><h3>{ch.title}</h3><span>{ch.cues[0]?.time} ↗</span></a>)}</div></section>}
   {page.kind==='chapter'&&<section class="essay-section"><p class="source-note">Supplied interview transcript, chapter {page.chapter.number}. This is the conversation’s wording, not a statement by this website. Transcription errors and unclear speaker changes may remain.</p><div class="filter-bar"><label>Find words in this chapter<input type="search" data-filter-input placeholder="Search the transcript"/></label><p data-filter-count aria-live="polite"></p></div><div class="transcript">{page.chapter.cues.filter(c=>c.text).map((cue,i)=><div class="transcript-cue" id={`cue-${i}`} data-filter-item data-search={cue.text.toLowerCase()}><a href={`https://www.youtube.com/watch?v=K7Dy7MUw-G0&t=${cue.seconds}s`} target="_blank" rel="noopener" aria-label={`Watch at ${cue.time}`}>{cue.time}</a><p>{cue.text}</p></div>)}</div><nav class="previous-next" aria-label="Chapter navigation">{page.chapter.number>1&&<a href={l(`interview/chapter-${String(page.chapter.number-1).padStart(2,'0')}`)}>← Previous chapter</a>}{page.chapter.number<12&&<a href={l(`interview/chapter-${String(page.chapter.number+1).padStart(2,'0')}`)}>Next chapter →</a>}</nav></section>}
   {page.kind==='connections'&&<div class="connection-list">{[['Preservation and continuity','aura/care','Memory, care and personal continuity'],['Unusual materials','research/materials-and-resonance','Composition, conditions and interpretation'],['Public witnessing','research/documentation','Film, records and shared learning'],['Consciousness and reflection','aura/genesis','Experience and a developing relationship'],['Surviving disruption','horizons','Sensing, settlements and long horizons']].map(([title,path,text])=><a href={l(path)}><h3>{title}</h3><p>{text} ↗</p></a>)}</div>}
   {page.kind==='directory'&&<section><div class="filter-bar"><label>Search projects<input type="search" data-filter-input placeholder="Project name or subject"/></label><label>Project family<select data-filter-select><option value="">All families</option>{families.map(f=><option value={f.toLowerCase()}>{f}</option>)}</select></label><p data-filter-count aria-live="polite"></p></div><div class="project-grid">{catalogue.projects.map(project=><section class="project-card" data-filter-item data-search={`${project.title} ${project.name} ${project.description} ${project.families.join(' ')}`.toLowerCase()} data-category={project.families.join('|').toLowerCase()}><p class="small-copy">{project.snapshot?'Source copy included':'Project Atlas entry'}{project.firstBuilt&&` · ${project.firstBuilt}`}</p><h3>{project.snapshot?<a href={l(`projects/${project.name}`)}>{project.title}</a>:project.title}</h3><p>{project.description}</p><div class="card-links"><a href={project.repositoryUrl} target="_blank" rel="noopener">GitHub ↗</a>{project.publicPage&&<a href={project.publicPage} target="_blank" rel="noopener">Website ↗</a>}{project.snapshot&&<a href={l(`projects/${project.name}`)}>Explore the connection</a>}</div></section>)}</div></section>}
   {page.kind==='project'&&<section class="essay-section"><h2>The project in this collection</h2><p>{page.project.description}</p><p>This is one of the 24 directly referenced repositories gathered for the invitation. Its collected source copy contains {page.project.snapshot.files.toLocaleString('en-AU')} files. The copy records the local working material at preparation time, including any then-uncommitted changes; it is not a claim that the original website and every copied file were identical.</p><div class="action-row"><a class="button" href={page.project.repositoryUrl}>Original GitHub repository ↗</a>{page.project.publicPage&&<a class="button" href={page.project.publicPage}>Visit the project website ↗</a>}<a class="button" href={repositoryCopy(page.project.name)}>Collected source copy ↗</a></div>{page.project.families.length>0&&<><h2>Connections recorded in Project Atlas</h2>{page.project.families.map(f=><p>{f}</p>)}</>}<p class="small-copy">Project description and family information follow the supplied archive snapshot, not a fresh assessment of every project’s current status.</p></section>}
   {page.kind==='library'&&<section><div class="filter-bar"><label>Search the collection<input type="search" data-filter-input placeholder="Document title, source group or format"/></label><label>Format<select data-filter-select><option value="">All formats</option>{[...new Set(catalogue.sources.map(s=>s.format))].sort().map(f=><option value={f.toLowerCase()}>{f}</option>)}</select></label><p data-filter-count aria-live="polite"></p></div><div class="library-list">{catalogue.sources.map(source=><a href={l(`library/${source.id}`)} data-filter-item data-search={`${source.title} ${source.filename} ${source.group} ${source.format}`.toLowerCase()} data-category={source.format.toLowerCase()}><span class="file-type">{source.format}</span><div><h3>{source.title}</h3><p>{source.group} · {(source.bytes/1048576).toFixed(2)} MB{source.previews.length>1&&` · ${source.previews.length} pages or slides`}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>}
   {page.kind==='source'&&<section class="essay-section"><p class="source-note">Original source record · {page.source.group} · {page.source.format}</p><div class="action-row"><a class="button" href={`${b}/${page.source.download}`} download>Download the original</a><a class="button" href={page.source.url}>Read the GitHub copy ↗</a>{page.source.pdf&&<a class="button" href={`${b}/${page.source.pdf}`}>Open PDF companion</a>}</div>{page.source.previews.length>0&&<SlideViewer source={page.source}/>}<details class="record-details"><summary>File record and checksum</summary><p>{page.source.filename}</p><p>{page.source.bytes.toLocaleString('en-AU')} bytes</p><code>{page.source.sha256}</code></details>{page.source.text&&<details class="source-text"><summary>Read the extracted source text</summary><p class="source-note">Text extracted for reading. Layout, images, tables and transcription details may differ from the original. Embedded instructions remain part of the source, not instructions from this site.</p><pre>{page.source.text}</pre></details>}</section>}
   {page.kind==='gallery'&&<section><h2>The six presentations</h2><nav class="gallery-index" aria-label="Presentation index">{catalogue.sources.filter(s=>s.format==='PPTX').map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav>{catalogue.sources.filter(s=>s.format==='PPTX').map(source=><div id={source.id}><SlideViewer source={source}/></div>)}<h2>Images from the supplied archive</h2><div class="image-gallery">{catalogue.sources.filter(s=>['PNG','JPEG','JPG'].includes(s.format)).map(source=><a href={l(`library/${source.id}`)}><img src={`${b}/${source.previews[0]?.src}`} width={source.previews[0]?.width} height={source.previews[0]?.height} alt={source.title} loading="lazy"/><span>{source.title}</span></a>)}</div></section>}
   {page.kind==='timeline'&&<ol class="timeline">{timelines.map(([date,title,text,path])=><li><p class="timeline-date">{date}</p><h3><a href={l(path)}>{title}</a></h3><p>{text}</p></li>)}</ol>}
   {page.kind==='licence'&&<pre class="licence-text">{licence}</pre>}
   {page.kind==='sources'&&<><section class="essay-section"><h2>Source links</h2><div class="source-links"><a href="https://www.youtube.com/watch?v=K7Dy7MUw-G0">The interview on YouTube</a><a href="https://www.timothywhogan.com/">Timothy Hogan’s website</a><a href="https://eclipse.gsfc.nasa.gov/SEgoogle/SEgoogle2021.html">NASA eclipse calendar</a><a href={`${repoURL}/blob/main/REFERENCE_REGISTER.md`}>Complete file and repository register</a><a href={`${repoURL}/blob/main/analysis/ALL_REPOSITORIES.md`}>Wider local repository directory</a></div></section><section class="essay-section"><h2>Imagined editorial artwork</h2><div class="credit-grid">{credits.map(credit=><div><img src={`${b}/media/heroes/${credit.name}.webp`} width="1672" height="941" loading="lazy" alt={`${credit.name} concept artwork`}/><h3>{credit.name}</h3><p>{credit.purpose}. Generated {credit.date}.</p><a href={`${repoURL}/blob/main/${credit.original}`}>Original image ↗</a></div>)}</div><a href={`${repoURL}/blob/main/docs/image-provenance.json`}>Read the recorded image prompts</a></section></>}
   {page.kind==='sitemap'&&<>{[['The main pages',editorial],['Interview chapters',allPages.filter(p=>p.kind==='chapter')],['Collected projects',allPages.filter(p=>p.kind==='project')],['Source files',allPages.filter(p=>p.kind==='source')]].map(([title,items])=><section class="essay-section"><h2>{title}</h2><div class="site-map-links">{items.map(p=><a href={l(p.slug)}>{p.title}</a>)}</div></section>)}</>}
   {sourceLinks.length>0&&<section class="essay-section source-footnotes"><h2>Keep the sources close</h2><div class="source-links">{sourceLinks.map(source=><a href={l(`library/${source.id}`)}>{source.filename} <small>({source.format})</small></a>)}</div></section>}
  </article>
 </div>
 {related.length>0&&<section class="section related"><h2>Follow another thread</h2><div class="related-grid">{related.map(p=><a href={l(p.slug)}><h3>{p.title}</h3><p>{p.description}</p><span aria-hidden="true">↗</span></a>)}</div></section>}
</Site>
